{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://aura-api-1080803822966.asia-south1.run.app/api"
      }
    },
    "athletes-preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "athletes"
      }
    },
    "athletes-production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "athletes"
      }
    },
    "officials-preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "officials"
      }
    },
    "officials-production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "officials"
      }
    },
    "athletes-usb-test": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "athletes",
        "EXPO_PUBLIC_API_URL": "http://localhost:5000/api"
      }
    },
    "staging": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://aura-api-staging-wgebilkjsa-el.a.run.app/api"
      }
    },
    "athletes-demo": {
      "extends": "staging",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "athletes"
      }
    },
    "officials-demo": {
      "extends": "staging",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "officials"
      }
    },
    "athletes-store-staging": {
      "extends": "staging",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "athletes"
      }
    }
  },
  "submit": {
    "athletes-production": {},
    "officials-production": {},
    "athletes-store-staging": {}
  }
}
