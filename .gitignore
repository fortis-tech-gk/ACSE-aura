# Root .gitignore

# Dependencies
node_modules
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build outputs
.next/
**/.next/
out/
build/
dist/

# Local Environment
.env
.env.local
.env*.local
**/.env
**/.env.local
**/.env*.local
.env.stag
.env.prod-db
**/.env.stag
**/.env.prod-db
**/.env*.stag
*.stag.md
!.env.example
!**/.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & IDE
.DS_Store
*.pem
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
**/.vercel
scratch/
prototype/
# Credentials — never commit (plaintext passphrases/PINs, and bcrypt hashes of
# low-entropy passphrases, which are cheap to brute-force offline)
docs/College Login Credentials*.xlsx
docs/Staff Login Credentials*.md
docs/staff_credentials_*.sql
supabase/migrations/college_credentials_*.sql
docs/*Credentials*.xlsx

# Work Trees
.claude/
# SQL that contains password / passphrase hashes — never commit (audit #8)
docs/admin_password_reset.sql
docs/vtu_sports_admin_login.sql
docs/*_password*.sql
docs/*_login*.sql
# Audit write-ups describe unfixed weaknesses — keep out of the public repo
docs/audit/

# Personal contact details (PED phones, principal emails/mobiles, addresses): never commit.
# The fortis-tech-gk/ACSE-aura repository is public.
docs/All PED*Phone*
docs/*pricipal*
docs/*principal*
docs/college_contact_updates.sql
docs/All College Address*
docs/management*details*
docs/college_division_ped_contact*
docs/reports/colleges-not-registered.*
